# Copy to .env for local testing only.
# On EC2 these live in /etc/mercury-proxy.env (chmod 600, root-owned).
# Never commit real values. Never put any of these in EXPO_PUBLIC_* — those are
# inlined into the app bundle at build time.

# Mercury Read-and-Write API token, including the "secret-token:" prefix.
# This is the only place in the entire system it should exist.
MERCURY_API_TOKEN=secret-token:mercury_production_xxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret the Supabase edge functions present as x-proxy-secret.
# Must be >= 32 chars; the server refuses to start otherwise.
# Generate with: openssl rand -hex 32
PROXY_SHARED_SECRET=

# Mercury account the payouts are sent from (uuid). Optional here — edge
# functions pass accountId per request; this is the fallback.
MERCURY_ACCOUNT_ID=

# Local listener. Caddy terminates TLS and reverse-proxies to this, so the
# Node process binds to loopback only and is never directly exposed.
PORT=8080
HOST=127.0.0.1

# Mercury API base. Defaults to production when unset.
# Sandbox: https://api-sandbox.mercury.com/api/v1  (sandbox-created tokens only)
# MERCURY_BASE_URL=

# Safety rails.
SEND_LIMIT_PER_MIN=120
UPSTREAM_TIMEOUT_MS=20000
LOG_LEVEL=info
