{
  "expo": {
    "name": "Noni",
    "slug": "noni",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "noni",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.fieldvision.noni",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Noni uses the camera so you can record content for your assigned tasks.",
        "NSMicrophoneUsageDescription": "Noni uses the mic so your recorded takes include audio.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "ai.noni.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Noni uses the camera so you can record content for your assigned tasks.",
          "microphonePermission": "Noni uses the mic so your recorded takes include audio.",
          "recordAudioAndroid": true
        }
      ],
      "expo-video",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Noni saves the account template profile picture to your photos so you can set it on TikTok and Instagram."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "90199b13-2017-498e-a189-9657d81e4e9b"
      }
    },
    "owner": "elanromo"
  }
}
